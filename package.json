    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.1.0",
    "storybook": "^10.6.5",
    "storybook-addon-pseudo-states": "^10.6.5",
    "typescript": "^7.0.2",
